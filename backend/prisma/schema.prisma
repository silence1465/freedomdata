generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum ServiceType {
  DATA_BUNDLE
  MTN_EXPRESS
  RESULT_CHECKER
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  REFUNDED
  REFUND_PROCESSING
}

enum LedgerType {
  TOPUP
  PURCHASE
  REFUND
  ADJUSTMENT
}

model User {
  id            String   @id @default(uuid())
  phone         String   @unique
  email         String?  @unique
  passwordHash  String
  name          String?
  role          Role     @default(CUSTOMER)
  walletBalance Decimal  @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  orders        Order[]
  ledgerEntries WalletLedger[]

  @@index([role])
}

model Product {
  id           String      @id @default(uuid())
  dataSikaId   String      @unique
  network      String
  bundleGb     Decimal     @db.Decimal(6, 2)
  costPrice    Decimal     @db.Decimal(10, 2)
  sellPrice    Decimal     @db.Decimal(10, 2)
  agentPrice   Decimal?    @db.Decimal(10, 2)
  serviceType  ServiceType @default(DATA_BUNDLE)
  isAvailable  Boolean     @default(true)
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())

  orders       Order[]

  @@index([network, serviceType])
}

model Order {
  id               String       @id @default(uuid())
  idempotencyKey   String       @unique
  dataSikaOrderId  String?      @unique
  userId           String
  productId        String
  recipient        String
  amountCharged    Decimal      @db.Decimal(10, 2)
  costAmount       Decimal      @db.Decimal(10, 2)
  status           OrderStatus  @default(PENDING)
  failureReason    String?
  pollAttempts     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id])
  product          Product      @relation(fields: [productId], references: [id])
  ledgerEntries    WalletLedger[]

  @@index([userId])
  @@index([status])
}

model WalletLedger {
  id           String     @id @default(uuid())
  userId       String
  orderId      String?
  type         LedgerType
  amount       Decimal    @db.Decimal(10, 2)
  balanceAfter Decimal    @db.Decimal(10, 2)
  reference    String?    @unique
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id])
  order        Order?     @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
}
